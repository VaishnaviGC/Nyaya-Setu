# Copy this file to .env and fill in your real values.

# Get a free Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional - override the default model
GEMINI_MODEL=gemini-3.8-flash

# Secret used to sign login tokens (JWT). Set this to any long random
# string before a real deployment - the default below is only safe for
# local development.
JWT_SECRET_KEY=dev-secret-change-me-before-deploying

# Optional - defaults to a local SQLite file (nyaya_setu.db) if unset.
# DATABASE_URL=sqlite:///./nyaya_setu.db
